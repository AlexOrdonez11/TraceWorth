  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "~5.9.3",
    "vite": "8.3.0"
  },
  "engines": {"node": ">=22.12.0"}
}
