aws_region          = "us-east-2"
expected_account_id = "REPLACE_WITH_12_DIGIT_ACCOUNT_ID"
alert_email         = "REPLACE_WITH_MONITORED_EMAIL"
# Replace with the actual public egress addresses, not private VPC addresses.
# Lambda without stable NAT egress cannot satisfy this allowlist reliably.
pilot_ipv4_cidrs = ["192.0.2.1/32"]
# Starts with no API service until an image exists. The rest of the stack is billable.
container_image   = null
api_desired_count = 0
